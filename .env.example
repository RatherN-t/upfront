# Copy this file to .env and paste your keys.
#
#   cp .env.example .env
#
# .env is gitignored. .env.example is committed and must never contain a
# real secret.
#
# ---------------------------------------------------------------------------
# USE THE **DEVELOPMENT** KEYS, NOT THE LIVE ONES
# ---------------------------------------------------------------------------
# web.getpinch.com.au/api-keys shows two sets. You want the second:
#
#   Live Keys          app_...        sk_live_...     <- DO NOT USE
#   Development Keys   app_test_...   sk_test_...     <- use these
#
# This project is test mode only (docs/00-decisions.md D10). The client
# refuses to start if it is handed an sk_live_ secret, so a slip here fails
# loudly instead of quietly touching a real account.
#
# The Publishable Key (pk_test_...) is only needed for CaptureJS card
# tokenisation in the browser. This prototype uses hosted Payment Links
# instead, so it is not required.

PINCH_APP_ID=app_test_paste_yours_here
PINCH_SECRET=sk_test_paste_yours_here
